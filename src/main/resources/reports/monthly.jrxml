<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="monthly" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="36" whenNoDataType="AllSectionsNoDetail">
 <style name="base" isDefault="true" fontName="DejaVu Sans" fontSize="10"/>
 <parameter name="USER_NAME" class="java.lang.String"/><parameter name="PERIOD" class="java.lang.String"/>
 <parameter name="REPORT_TITLE" class="java.lang.String"/><parameter name="ISSUED" class="java.lang.String"/>
 <parameter name="INCOME" class="java.math.BigDecimal"/><parameter name="EXPENSE" class="java.math.BigDecimal"/><parameter name="BALANCE" class="java.math.BigDecimal"/>
 <field name="date" class="java.lang.String"/><field name="description" class="java.lang.String"/>
 <field name="category" class="java.lang.String"/><field name="kind" class="java.lang.String"/><field name="amount" class="java.math.BigDecimal"/>
 <title><band height="156">
  <staticText><reportElement x="0" y="0" width="515" height="30" forecolor="#163B35"/><textElement><font size="25" isBold="true"/></textElement><text><![CDATA[Brújula]]></text></staticText>
  <textField><reportElement x="0" y="40" width="515" height="25"/><textElement><font size="17" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
  <textField><reportElement x="0" y="72" width="515" height="18"/><textFieldExpression><![CDATA[$P{USER_NAME} + "  ·  Periodo: " + $P{PERIOD}]]></textFieldExpression></textField>
  <textField><reportElement x="0" y="102" width="515" height="18"/><textFieldExpression><![CDATA["Ingresos: S/ " + $P{INCOME}.setScale(2) + "     Gastos: S/ " + $P{EXPENSE}.setScale(2)]]></textFieldExpression></textField>
  <textField><reportElement x="0" y="126" width="515" height="20" forecolor="#163B35"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA["Balance del mes: S/ " + $P{BALANCE}.setScale(2)]]></textFieldExpression></textField>
 </band></title>
 <columnHeader><band height="28">
  <staticText><reportElement mode="Opaque" x="0" y="0" width="515" height="24" backcolor="#E8EFED"/><text><![CDATA[]]></text></staticText>
  <staticText><reportElement x="4" y="5" width="70" height="16"/><text><![CDATA[Fecha]]></text></staticText>
  <staticText><reportElement x="78" y="5" width="230" height="16"/><text><![CDATA[Descripción / categoría]]></text></staticText>
  <staticText><reportElement x="329" y="5" width="70" height="16"/><text><![CDATA[Tipo]]></text></staticText>
  <staticText><reportElement x="407" y="5" width="104" height="16"/><textElement textAlignment="Right"/><text><![CDATA[Monto (S/)]]></text></staticText>
 </band></columnHeader>
 <detail><band height="60" splitType="Stretch">
  <textField><reportElement x="4" y="4" width="72" height="18"/><textFieldExpression><![CDATA[$F{date}]]></textFieldExpression></textField>
  <textField textAdjust="StretchHeight"><reportElement x="78" y="4" width="245" height="32"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
  <textField textAdjust="StretchHeight"><reportElement positionType="Float" x="78" y="37" width="245" height="18" forecolor="#667673"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{category}]]></textFieldExpression></textField>
  <textField><reportElement x="329" y="4" width="74" height="18"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{kind}]]></textFieldExpression></textField>
  <textField pattern="#,##0.00"><reportElement x="407" y="4" width="104" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
 </band></detail>
 <pageFooter><band height="35">
  <textField><reportElement x="0" y="12" width="415" height="16" forecolor="#667673"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Brújula · Finanzas personales · Emitido " + $P{ISSUED}]]></textFieldExpression></textField>
  <textField><reportElement x="415" y="12" width="100" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
 </band></pageFooter>
</jasperReport>
